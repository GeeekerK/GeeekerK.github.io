<% var pubs = site.data.publications || {}; %>
<section class="shell page-head">
  <p class="mono eyebrow">/// PUBLICATIONS</p>
  <h1 class="page-title">著作<span class="grad-text">.</span></h1>
  <p class="page-sub">论文、文章与书——思考的三种装订方式。</p>
</section>

<% if (pubs.papers && pubs.papers.length) { %>
<section class="shell pub-section">
  <h2 class="section-title mono">PAPERS <span class="grad-text">//</span> <span class="section-count"><%= pubs.papers.length %></span></h2>
  <div class="pub-list">
    <% pubs.papers.forEach(function (pub, i) { %>
      <div class="pub-row">
        <span class="pub-no mono">[<%= pubs.papers.length - i %>]</span>
        <div class="pub-main">
          <p class="pub-title"><%= pub.title %></p>
          <p class="pub-venue"><%= pub.authors %>. <em><%= pub.venue %></em>, <%= pub.year %>.</p>
        </div>
        <% if (pub.link) { %><a class="pub-link mono" href="<%= pub.link %>">PDF →</a><% } %>
      </div>
    <% }) %>
  </div>
</section>
<% } %>

<% if (pubs.articles && pubs.articles.length) { %>
<section class="shell pub-section">
  <h2 class="section-title mono">ARTICLES <span class="grad-text">//</span> <span class="section-count"><%= pubs.articles.length %></span></h2>
  <div class="pub-list">
    <% pubs.articles.forEach(function (pub) { %>
      <div class="pub-row">
        <span class="pub-year mono"><%= pub.year %></span>
        <div class="pub-main">
          <p class="pub-title"><%= pub.title %></p>
          <p class="pub-venue"><%= pub.venue %></p>
        </div>
        <% if (pub.link) { %><a class="pub-link mono" href="<%= pub.link %>">阅读 →</a><% } %>
      </div>
    <% }) %>
  </div>
</section>
<% } %>

<% if (pubs.books && pubs.books.length) { %>
<section class="shell pub-section">
  <h2 class="section-title mono">BOOKS <span class="grad-text">//</span> <span class="section-count"><%= pubs.books.length %></span></h2>
  <div class="bookshelf">
    <% pubs.books.forEach(function (book) { %>
      <div class="book">
        <div class="book-cover">
          <p class="book-cover-title"><%= book.title %></p>
          <p class="book-cover-author mono"><%= book.role %> · <%= book.year %></p>
        </div>
        <p class="book-publisher mono"><%= book.publisher %></p>
      </div>
    <% }) %>
  </div>
</section>
<% } %>
