<%
  var isAnnual = page.categories && page.categories.some(function (c) { return c.name === '年报'; });
%>
<article class="article shell<%= isAnnual ? ' article-annual' : '' %>">
  <% if (isAnnual) { %>
    <!-- 年报：亮色纸章，暗夜中的跨页 -->
    <header class="article-header chapter-light">
      <div class="article-header-inner shell">
        <p class="mono chapter-eyebrow">ANNUAL REPORT · <%= date(page.date, 'YYYY') %></p>
        <h1 class="article-title"><%= page.title %></h1>
        <div class="article-meta mono">
          <time><%= date(page.date, 'YYYY.MM.DD') %></time>
          <% if (page.tags && page.tags.length) { %>
            <span>·</span>
            <% page.tags.each(function (tag) { %><a class="meta-link" href="<%- url_for(tag.path) %>">#<%= tag.name %></a><% }) %>
          <% } %>
        </div>
      </div>
    </header>
  <% } else { %>
    <header class="article-header">
      <div class="article-meta mono">
        <time><%= date(page.date, 'YYYY.MM.DD') %></time>
        <% if (page.categories && page.categories.length) { %>
          <span>·</span>
          <% page.categories.each(function (cat) { %>
            <a class="meta-link" href="<%- url_for(cat.path) %>"><%= cat.name %></a>
          <% }) %>
        <% } %>
      </div>
      <h1 class="article-title"><%= page.title %></h1>
      <% if (page.tags && page.tags.length) { %>
        <div class="article-tags mono">
          <% page.tags.each(function (tag) { %>
            <a class="tag" href="<%- url_for(tag.path) %>">#<%= tag.name %></a>
          <% }) %>
        </div>
      <% } %>
    </header>
  <% } %>

  <div class="article-content">
    <%- page.content %>
  </div>

  <nav class="article-nav mono">
    <% if (page.prev) { %>
      <a class="article-nav-link" href="<%- url_for(page.prev.path) %>">← <%= page.prev.title %></a>
    <% } else { %><span></span><% } %>
    <% if (page.next) { %>
      <a class="article-nav-link" href="<%- url_for(page.next.path) %>"><%= page.next.title %> →</a>
    <% } %>
  </nav>
</article>
