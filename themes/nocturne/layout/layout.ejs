<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= config.description %>">
  <title><% if (page.title) { %><%= page.title %> · <% } %><%= config.title %></title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='40' fill='%238B7CF6'/></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="<%- url_for('/css/style.css') %>">
</head>
<body>
  <canvas id="particle-field" aria-hidden="true"></canvas>

  <header class="site-header">
    <div class="shell header-inner">
      <a class="brand" href="<%- url_for('/') %>">
        <span class="brand-pulse"></span><%= config.title %><span class="brand-cursor">_</span>
      </a>
      <nav class="nav">
        <% for (var label in theme.menu) { %>
          <a href="<%- url_for(theme.menu[label]) %>" class="nav-link<% if (is_current(theme.menu[label])) { %> active<% } %>"><%= label %></a>
        <% } %>
      </nav>
    </div>
  </header>

  <main>
    <%- body %>
  </main>

  <footer class="site-footer">
    <div class="shell footer-inner">
      <div class="footer-status mono">
        <span class="brand-pulse small"></span> ALL SYSTEMS NOMINAL
      </div>
      <div class="footer-links mono">
        <% for (var name in theme.social) { %>
          <a href="<%= theme.social[name].startsWith('http') || theme.social[name].startsWith('/') ? theme.social[name] : '#' %>"><%= name %></a>
        <% } %>
      </div>
      <p class="footer-meta mono">© <%= date(new Date(), 'YYYY') %> <%= theme.author %> · BUILT WITH HEXO · RENDERED IN THE DARK</p>
    </div>
  </footer>

  <script src="<%- url_for('/js/main.js') %>"></script>
</body>
</html>
