<section class="container page-head">
  <p class="vertical head-vertical"><%= __('contact.vertical') %></p>
  <div>
    <p class="eyebrow"><%= __('contact.eyebrow') %></p>
    <h1 class="page-title"><%= __('contact.title') %></h1>
    <p class="page-sub"><%= __('contact.sub') %></p>
  </div>
</section>

<section class="container contact-grid">
  <div class="contact-block profile-block">
    <div class="profile-avatar-wrap">
      <img class="profile-avatar" src="/images/avatar.jpg" alt="WangWei">
    </div>
    <div class="profile-name">WangWei · he/him</div>
    <p class="profile-bio">梦想是成为 bartender 🍸 兴趣是探索学习 🆕</p>
  </div>

  <div class="contact-block">
    <h2 class="contact-label"><%= __('contact.socials') %></h2>
    <div class="contact-socials">
      <% for (var name in theme.social) { %>
        <% if (name === 'WeChat') { %>
          <div class="contact-social contact-social-wechat">
            <span>WeChat</span>
            <span class="contact-wechat-toggle" onclick="var el=this.parentNode.querySelector('.contact-wechat-id'); if(el.style.display==='none'||!el.style.display){el.style.display='block';this.textContent='−';}else{el.style.display='none';this.textContent='+';}">+</span>
            <span class="contact-wechat-id" style="display:none;margin-top:6px;font-size:0.9em;color:var(--muted);">17855219101</span>
          </div>
        <% } else { %>
          <a class="contact-social" href="<%= theme.social[name].startsWith('http') || theme.social[name].startsWith('/') ? theme.social[name] : '#' %>">
            <span><%= name %></span>
            <span class="contact-arrow">↗</span>
          </a>
        <% } %>
      <% } %>
    </div>
  </div>

  <div class="contact-block">
    <h2 class="contact-label"><%= __('contact.email') %></h2>
    <a class="contact-email" href="mailto:<%= theme.email %>"><%= theme.email %></a>
    <p class="contact-note"><%= __('contact.email_note') %></p>
  </div>

  <div class="contact-block cv-block">
    <h2 class="contact-label"><%= __('contact.cv') %></h2>
    <p class="contact-note"><%= __('contact.cv_note') %></p>
    <a class="btn btn-primary" href="<%- url_for((page.lang && page.lang !== config.language[0] ? '/' + page.lang : '') + '/cv/') %>"><%= __('contact.cv_btn') %></a>
  </div>
</section>
