<%
  var _lang = page.lang || 'zh-CN';
  var _isDefault = _lang === config.language[0];
  var _prefix = _isDefault ? '' : '/' + _lang;
%>
<!DOCTYPE html>
<html lang="<%= _lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= config.description %>">
  <%- open_graph({ twitter_card: 'summary', image: url_for('/images/og-cover.png') }) %>
  <%- feed_tag('atom.xml', { title: config.title }) %>
  <title><% if (page.title) { %><%= page.title %> · <% } %><%= config.title %></title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect x='16' y='16' width='68' height='68' rx='6' fill='%23C0392B'/><text x='50' y='66' font-size='44' text-anchor='middle' fill='%23F5F4ED' font-family='serif'><%= theme.seal_char %></text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Noto+Serif+SC:wght@400;500;600&family=Noto+Serif+JP:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="<%- url_for('/css/style.css') %>">
  <script>
    (function () {
      var t = localStorage.getItem('wenfang-theme');
      if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="<%- url_for(_prefix + '/') %>">
        <span class="seal seal-s"><%= theme.seal_char %></span>
        <span class="brand-name"><%= config.title %></span>
      </a>
      <nav class="nav">
        <a class="nav-link<% if (is_home()) { %> active<% } %>" href="<%- url_for(_prefix + '/') %>"><%= __('menu.home') %></a>
        <a class="nav-link<% if (is_archive()) { %> active<% } %>" href="<%- url_for(_prefix + '/archives/') %>"><%= __('menu.archives') %></a>
        <a class="nav-link<% if (is_current('projects')) { %> active<% } %>" href="<%- url_for(_prefix + '/projects/') %>"><%= __('menu.projects') %></a>
        <a class="nav-link<% if (is_current('publications')) { %> active<% } %>" href="<%- url_for(_prefix + '/publications/') %>"><%= __('menu.publications') %></a>
        <a class="nav-link<% if (is_current('about')) { %> active<% } %>" href="<%- url_for(_prefix + '/about/') %>"><%= __('menu.about') %></a>
        <a class="nav-link<% if (is_current('contact')) { %> active<% } %>" href="<%- url_for(_prefix + '/contact/') %>"><%= __('menu.contact') %></a>
        <%
          // 三语循环：中(默认/) -> en(/en/) -> ja(/ja/) -> 中
          var _nextHref, _nextBadge, _nextTitle;
          if (_isDefault) {
            _nextHref = url_for('/en/'); _nextBadge = 'EN'; _nextTitle = 'Switch to English';
          } else if (_prefix === '/en') {
            _nextHref = url_for('/ja/'); _nextBadge = '日'; _nextTitle = '日本語へ切替';
          } else {
            _nextHref = url_for('/'); _nextBadge = '中'; _nextTitle = '切换到中文';
          }
        %>
        <a class="lang-switch" href="<%- _nextHref %>" title="<%= _nextTitle %>" aria-label="<%= _nextTitle %>">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.5 2.6 3.9 5.7 3.9 9s-1.4 6.4-3.9 9c-2.5-2.6-3.9-5.7-3.9-9S9.5 5.6 12 3z"/></svg>
          <span class="lang-badge"><%= _nextBadge %></span>
        </a>
        <button id="theme-toggle" class="theme-toggle" aria-label="切换深色模式">
          <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>
        </button>
      </nav>
    </div>
  </header>

  <main>
    <%- body %>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-seal-row">
        <span class="seal"><%= theme.seal_char %></span>
        <p class="footer-motto vertical"><%= theme.vertical_motto %></p>
        <div class="footer-text">
          <p class="footer-tag"><%= __('footer.tagline') %></p>
          <div class="footer-links">
            <% for (var name in theme.social) { %>
              <a href="<%= theme.social[name].startsWith('http') || theme.social[name].startsWith('/') ? theme.social[name] : '#' %>"><%= name %></a>
            <% } %>
          </div>
          <p class="footer-meta"><%= __('footer.meta', theme.since, date(new Date(), 'YYYY'), theme.author, theme.since) %></p>
        </div>
      </div>
    </div>
  </footer>

  <script src="<%- url_for('/js/main.js') %>"></script>
</body>
</html>
