<% var pubs = site.data.publications || {}; %>
<section class="container page-head">
  <p class="vertical head-vertical"><%= __('publications.vertical') %></p>
  <div>
    <p class="eyebrow"><%= __('publications.eyebrow') %></p>
    <h1 class="page-title"><%= __('publications.title') %></h1>
    <p class="page-sub"><%= __('publications.sub') %></p>
  </div>
</section>

<% if (pubs.articles && pubs.articles.length) { %>
<section class="container pub-section">
  <h2 class="section-title"><span class="juan"><%= __('publications.articles') %></span><%= __('publications.articles_title') %> <span class="section-count"><%= pubs.articles.length %></span></h2>
  <%
    // 按年份分组，年份降序（最新年在最左列），列内已按 link 日期倒序
    var yearGroups = {};
    pubs.articles.forEach(function (pub) {
      var y = String(pub.year);
      if (!yearGroups[y]) yearGroups[y] = [];
      yearGroups[y].push(pub);
    });
    var years = Object.keys(yearGroups).sort().reverse();
  %>
  <div class="year-cols">
    <% years.forEach(function (y) { %>
      <div class="year-col">
        <p class="year-col-head"><%= y %></p>
        <% var yearPosts = yearGroups[y]; %>
        <% var showCount = Math.min(8, yearPosts.length); %>
        <% for (var i = 0; i < showCount; i++) { var pub = yearPosts[i]; %>
          <div class="pub-row tight">
            <div class="pub-main">
              <p class="pub-title"><a href="<%= pub.link %>"><%= pub.title %></a></p>
              <p class="pub-venue"><%= pub.venue %></p>
            </div>
          </div>
        <% } %>
        <% if (yearPosts.length > 8) { %>
          <div class="more-toggle" data-year="<%= y %>">more ▾</div>
          <div class="more-posts" data-year="<%= y %>" style="display:none;">
            <% for (var i = 8; i < yearPosts.length; i++) { var pub = yearPosts[i]; %>
              <div class="pub-row tight">
                <div class="pub-main">
                  <p class="pub-title"><a href="<%= pub.link %>"><%= pub.title %></a></p>
                  <p class="pub-venue"><%= pub.venue %></p>
                </div>
              </div>
            <% } %>
          </div>
        <% } %>
      </div>
    <% }) %>
  </div>

  <% if (site.tags && site.tags.length) { %>
  <div class="pub-tags-cloud">
    <% site.tags.toArray().sort(function(a,b){return b.length-a.length;}).forEach(function(tag) { %>
      <a class="pub-tag" href="<%- url_for(tag.path) %>"><%= tag.name %> <span class="tag-count"><%= tag.length %></span></a>
    <% }) %>
  </div>
  <% } %>

  <script>
  document.querySelectorAll(".more-toggle").forEach(function(btn) {
    btn.addEventListener("click", function() {
      var y = btn.getAttribute("data-year");
      var panel = document.querySelector('.more-posts[data-year="'+y+'"]');
      if (panel.style.display === "none") {
        panel.style.display = "";
        btn.textContent = "less ▴";
      } else {
        panel.style.display = "none";
        btn.textContent = "more ▾";
      }
    });
  });
  </script>
</section>
<% } %>

<% if ((pubs.podcasts && pubs.podcasts.length) || (pubs.videos && pubs.videos.length)) { %>
<section class="container pub-section pub-media">
  <div class="media-cols">
    <% if (pubs.podcasts && pubs.podcasts.length) { %>
    <div class="media-col">
      <h2 class="section-title"><span class="juan"><%= __('publications.podcasts') %></span><%= __('publications.podcasts_title') %> <span class="section-count"><%= pubs.podcasts.length %></span></h2>
      <div class="pub-list compact">
        <% pubs.podcasts.forEach(function (pub) { %>
          <div class="pub-row">
            <span class="pub-year"><%= pub.year %></span>
            <div class="pub-main">
              <p class="pub-title"><%= pub.title %></p>
              <p class="pub-venue"><%= pub.venue %></p>
            </div>
            <% if (pub.link) { %><a class="pub-link" href="<%= pub.link %>">收听 →</a><% } %>
          </div>
        <% }) %>
      </div>
    </div>
    <% } %>
    <% if (pubs.videos && pubs.videos.length) { %>
    <div class="media-col">
      <h2 class="section-title"><span class="juan"><%= __('publications.videos') %></span><%= __('publications.videos_title') %> <span class="section-count"><%= pubs.videos.length %></span></h2>
      <div class="pub-list compact">
        <% pubs.videos.forEach(function (pub) { %>
          <div class="pub-row">
            <span class="pub-year"><%= pub.year %></span>
            <div class="pub-main">
              <p class="pub-title"><%= pub.title %></p>
              <p class="pub-venue"><%= pub.venue %></p>
            </div>
            <% if (pub.link) { %><a class="pub-link" href="<%= pub.link %>">观看 →</a><% } %>
          </div>
        <% }) %>
      </div>
    </div>
    <% } %>
  </div>
</section>
<% } %>

<% if (pubs.papers && pubs.papers.length) { %>
<section class="container pub-section">
  <h2 class="section-title"><span class="juan"><%= __('publications.papers') %></span><%= __('publications.papers_title') %> <span class="section-count"><%= pubs.papers.length %></span></h2>
  <div class="pub-list academic">
    <% pubs.papers.forEach(function (pub, i) { %>
      <div class="pub-row">
        <span class="pub-no"><%= ['其一', '其二', '其三', '其四', '其五', '其六'][pubs.papers.length - 1 - i] || '[' + (pubs.papers.length - i) + ']' %></span>
        <div class="pub-main">
          <p class="pub-title"><%= pub.title %></p>
          <p class="pub-venue"><%= pub.authors %>. <em><%= pub.venue %></em>, <%= pub.year %>.</p>
        </div>
        <% if (pub.link) { %><a class="pub-link" href="<%= pub.link %>">PDF →</a><% } %>
      </div>
    <% }) %>
  </div>
</section>
<% } %>

<% if (pubs.books && pubs.books.length) { %>
<section class="container pub-section">
  <h2 class="section-title"><span class="juan"><%= __('publications.books') %></span><%= __('publications.books_title') %> <span class="section-count"><%= pubs.books.length %></span></h2>
  <div class="bookshelf">
    <% pubs.books.forEach(function (book) { %>
      <div class="book">
        <div class="book-cover">
          <p class="book-cover-title">《<%= book.title %>》</p>
          <p class="book-cover-author"><%= book.role %> · <%= book.year %></p>
        </div>
        <p class="book-publisher"><%= book.publisher %></p>
      </div>
    <% }) %>
  </div>
</section>
<% } %>
