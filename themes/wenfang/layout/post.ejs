<%
  var isAnnual = page.categories && page.categories.some(function (c) { return c.name === '年报' || c.name === '年報'; });
%>
<article class="article container<%= isAnnual ? ' article-annual' : '' %>">
  <% if (isAnnual) { %>
    <!-- 年报：深色卷首 + 印章 -->
    <header class="article-header chapter-dark">
      <div class="article-header-inner container">
        <div class="chapter-flex">
          <p class="vertical chapter-vertical"><%= __('annual.vertical', date(page.date, 'YYYY')) %></p>
          <div>
            <div class="article-meta">
              <time><%= date(page.date, 'YYYY年M月D日') %></time>
              <span class="dot-sep">·</span>
              <span><%= __('annual.label') %></span>
            </div>
            <h1 class="article-title"><%= page.title %></h1>
            <span class="seal seal-l"><%= theme.seal_char %></span>
          </div>
        </div>
      </div>
    </header>
  <% } else { %>
    <header class="article-header">
      <div class="article-meta">
        <time><%= date(page.date, 'YYYY年M月D日') %></time>
        <% if (page.categories && page.categories.length) { %>
          <span class="dot-sep">·</span>
          <% page.categories.each(function (cat) { %>
            <a class="meta-link" href="<%- url_for(cat.path) %>"><%= cat.name %></a>
          <% }) %>
        <% } %>
      </div>
      <h1 class="article-title"><%= page.title %></h1>
      <% if (page.tags && page.tags.length) { %>
        <div class="article-tags">
          <% page.tags.each(function (tag) { %>
            <a class="tag" href="<%- url_for(tag.path) %>"><%= tag.name %></a>
          <% }) %>
        </div>
      <% } %>
    </header>
  <% } %>

  <div class="article-content">
    <%- page.content %>
  </div>

  <nav class="article-nav">
    <% if (page.prev) { %>
      <a class="article-nav-link" href="<%- url_for(page.prev.path) %>">← <%= page.prev.title %></a>
    <% } else { %><span></span><% } %>
    <% if (page.next) { %>
      <a class="article-nav-link" href="<%- url_for(page.next.path) %>"><%= page.next.title %> →</a>
    <% } %>
  </nav>
</article>
