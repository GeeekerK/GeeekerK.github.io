<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= config.description %>">
  <title><% if (page.title) { %><%= page.title %> · <% } %><%= config.title %></title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect x='16' y='16' width='68' height='68' fill='%23C0392B'/><text x='50' y='66' font-size='44' text-anchor='middle' fill='%23F7F4EC' font-family='serif'><%= theme.seal_char %></text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Noto+Serif+SC:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="<%- url_for('/css/style.css') %>">
</head>
<body>
  <!-- 沿页边流动的竖排题字 -->
  <p class="edge-text vertical" aria-hidden="true"><%= theme.vertical_motto %> · 吾将上下而求索</p>

  <header class="site-header">
    <div class="shell header-inner">
      <a class="brand" href="<%- url_for('/') %>">
        <span class="seal seal-s"><%= theme.seal_char %></span>
        <span class="brand-name"><%= config.title %></span>
      </a>
      <nav class="nav">
        <% for (var label in theme.menu) { %>
          <a href="<%- url_for(theme.menu[label]) %>" class="nav-link<% if (is_current(theme.menu[label])) { %> active<% } %>"><%= label %></a>
        <% } %>
      </nav>
    </div>
  </header>

  <main>
    <%- body %>
  </main>

  <footer class="site-footer">
    <div class="shell footer-inner">
      <div class="footer-seal-row">
        <span class="seal"><%= theme.seal_char %></span>
        <div>
          <p class="footer-note">© <%= date(new Date(), 'YYYY') %> <%= theme.author %> · <%= theme.tagline %></p>
          <div class="footer-links">
            <% for (var name in theme.social) { %>
              <a href="<%= theme.social[name].startsWith('http') || theme.social[name].startsWith('/') ? theme.social[name] : '#' %>"><%= name %></a>
            <% } %>
          </div>
        </div>
      </div>
      <p class="footer-craft">纸墨为骨 · Hexo 静态生成 · <%= ganzhi(new Date()) %>镌</p>
    </div>
  </footer>

  <script src="<%- url_for('/js/main.js') %>"></script>
</body>
</html>
