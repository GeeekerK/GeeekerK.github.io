<%
  var isAnnual = page.categories && page.categories.some(function (c) { return c.name === '年报'; });
%>
<article class="article shell-narrow<%= isAnnual ? ' article-annual' : '' %>">
  <header class="article-header">
    <p class="caption">
      <%= page.categories.length ? page.categories.first().name : '随笔' %>
      ·
      <%= date(page.date, 'YYYY.MM.DD') %>
    </p>
    <h1 class="article-title<%= isAnnual ? ' annual-title' : '' %>"><%= page.title %></h1>
    <% if (page.tags && page.tags.length) { %>
      <p class="article-tags">
        <% page.tags.each(function (tag) { %>
          <a class="tag" href="<%- url_for(tag.path) %>"><%= tag.name %></a>
        <% }) %>
      </p>
    <% } %>
  </header>

  <div class="article-content">
    <%- page.content %>
  </div>

  <nav class="article-nav">
    <% if (page.prev) { %>
      <a href="<%- url_for(page.prev.path) %>">← <%= page.prev.title %></a>
    <% } else { %><span></span><% } %>
    <% if (page.next) { %>
      <a href="<%- url_for(page.next.path) %>"><%= page.next.title %> →</a>
    <% } %>
  </nav>
</article>
