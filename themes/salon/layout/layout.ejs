<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= config.description %>">
  <title><% if (page.title) { %><%= page.title %> · <% } %><%= config.title %></title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect x='14' y='14' width='72' height='72' rx='18' fill='%23C96442'/></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Noto+Serif+SC:wght@400;500&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="<%- url_for('/css/style.css') %>">
  <script>
    (function () {
      var t = localStorage.getItem('salon-theme');
      if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="<%- url_for('/') %>"><%= config.title %><span class="brand-dot">.</span></a>
      <nav class="nav">
        <% for (var label in theme.menu) { %>
          <a href="<%- url_for(theme.menu[label]) %>" class="nav-link<% if (is_current(theme.menu[label])) { %> active<% } %>"><%= label %></a>
        <% } %>
        <button id="theme-toggle" class="theme-toggle" aria-label="切换深色模式">
          <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>
        </button>
      </nav>
    </div>
  </header>

  <main>
    <%- body %>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-left">
        <span class="brand small"><%= config.title %><span class="brand-dot">.</span></span>
        <p class="footer-tag"><%= theme.tagline %></p>
      </div>
      <div class="footer-right">
        <% for (var name in theme.social) { %>
          <a class="footer-link" href="<%= theme.social[name].startsWith('http') || theme.social[name].startsWith('/') ? theme.social[name] : '#' %>"><%= name %></a>
        <% } %>
      </div>
      <p class="footer-meta">© <%= date(new Date(), 'YYYY') %> <%= theme.author %> · Powered by Hexo · 手工打磨的 Salon 主题</p>
    </div>
  </footer>

  <script src="<%- url_for('/js/main.js') %>"></script>
</body>
</html>
